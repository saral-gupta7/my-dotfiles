{
  "icon_theme": "Zed (Default)",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "prettier": {
    "allowed": true
  },
  "vim_mode": true,
  "ui_font_size": 17,
  "buffer_font_size": 5,
  "theme": {
    "mode": "dark",
    "light": "Neovim default light",
    "dark": "Ayu Mirage",
  },
  "autosave": "on_focus_change",
}
