############################################
# 1. Core Shell Behavior
############################################
zmodload zsh/zprof

set -o vi
bindkey -M viins 'jk' vi-cmd-mode

export EDITOR="nvim"
export VISUAL="nvim"

export ZSH="$HOME/.oh-my-zsh"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting you-should-use web-search)
# plugins=(git zsh-syntax-highlighting you-should-use web-search)
source $ZSH/oh-my-zsh.sh


############################################
# 2. Language Runtimes & Package Managers
############################################

export PATH="$PATH:$HOME/scripts"
# Rust
export PATH="$HOME/.cargo/bin:$PATH"

# Go
export GOPATH="$HOME/go"
export PATH="/usr/local/go/bin:$GOPATH/bin:$HOME/.local/opt/go/bin:$PATH"

# Mise
# eval "$($HOME/.local/bin/mise activate zsh)"

# ASDF
# export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"

rbenv() {
  unfunction rbenv
  eval "$(command rbenv init - zsh)"
  rbenv "$@"
}

export NVM_DIR="$HOME/.nvm"

# Lazy NVM: only loads when first invoked
nvm() {
  unfunction nvm node npm npx
  [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
  nvm "$@"
}
node() { nvm; node "$@" }
npm()  { nvm; npm  "$@" }
npx()  { nvm; npx  "$@" }

# Delay heavy stuff
autoload -Uz add-zsh-hook
add-zsh-hook precmd _lazy_init

_lazy_init() {
  add-zsh-hook -d precmd _lazy_init
  eval "$(starship init zsh)"
}

if [ -f "$HOME/.conda_zsh_hook.zsh" ]; then
  source "$HOME/.conda_zsh_hook.zsh"
else
  __conda_setup="$('/opt/anaconda3/bin/conda' 'shell.zsh' 'hook' 2>/dev/null)"
  if [ $? -eq 0 ]; then
    echo "$__conda_setup" > "$HOME/.conda_zsh_hook.zsh"
    eval "$__conda_setup"
  fi
fi

# PNPM
export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# Solana
export PATH="$HOME/.local/share/solana/install/active_release/bin:$PATH"

# Android
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$PATH"

# PHP (Herd)
# export PATH="$HOME/Library/Application Support/Herd/bin:$PATH"
# export HERD_PHP_82_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/82/"
# export HERD_PHP_83_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/83/"
# export HERD_PHP_84_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/84/"


############################################
# 3. Homebrew & System Libraries (no brew calls)
############################################

export HOMEBREW_PREFIX="/opt/homebrew"
export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/opt/openjdk/bin:$HOMEBREW_PREFIX/opt/bison/bin:$PATH"

export CFLAGS="-I$HOMEBREW_PREFIX/opt/bison/share/include $CFLAGS"
export CXXFLAGS="-I$HOMEBREW_PREFIX/opt/bison/share/include $CXXFLAGS"
export LDFLAGS="-L$HOMEBREW_PREFIX/opt/libffi/lib"
export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/libffi/include"
export PKG_CONFIG_PATH="$HOMEBREW_PREFIX/opt/openssl@3/lib/pkgconfig:$HOMEBREW_PREFIX/opt/libffi/lib/pkgconfig"
export LIBRARY_PATH="$HOMEBREW_PREFIX/opt/libiconv/lib:$LIBRARY_PATH"
export C_INCLUDE_PATH="$HOMEBREW_PREFIX/opt/libiconv/include:$C_INCLUDE_PATH"


############################################
# 4. Prompt, FZF, Navigation
############################################

# eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
eval "$(fzf --zsh)"

export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

_fzf_compgen_path() { fd --hidden --exclude .git . "$1" }
_fzf_compgen_dir() { fd --type=d --hidden --exclude .git . "$1" }

source ~/fzf-git.sh/fzf-git.sh


############################################
# 5. Tools & CLIs
############################################

function f() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

export PATH="$HOME/Downloads/google-cloud-sdk/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"
export PATH="$HOME/.console-ninja/.bin:$PATH"


############################################
