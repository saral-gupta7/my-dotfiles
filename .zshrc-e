alias life='vim ~/Desktop/lf/life/life.md'
alias book='f ~/Desktop/lf/subjects/CS/Books/'
alias phr='vim ~/Desktop/lf/subjects/life/language/english/phrase.md'
alias word='vim ~/Desktop/lf/subjects/life/language/English/words.md'
alias pdf='img2pdf'
alias p='python'
alias grep="rg"
alias cr='cargo run'
alias cfs='vim ~/Desktop/lf/subjects/CS/Codeforces/codeforces-learnings/learnings.md'
